
# run DCD command to init DDR
SDP: dcd -f u-boot-dtb.imx

# download u-boot image
SDP: write -f u-boot-dtb.imx -ivt 0

# download other images
SDP: write -f zImage -addr 0x83800000
SDP: write -f mx6ull_dev.dtb -addr 0x83000000
SDP: write -f rootfs.uImage -addr 0x86800000

# start u-boot
SDP: jump -f u-boot-dtb.imx -ivt 0

# fastboot set environment variables
FB: ucmd setenv bootargs 'console=ttymxc2,115200'
FB: ucmd setenv kernel_addr_r 0x83800000
FB: ucmd setenv cpio_addr_r 0x86800000
FB: ucmd setenv fdt_addr_r 0x83000000
FB: ucmd setenv bootcmd bootz bootz ${kernel_addr_r} ${cpio_addr_r} ${fdt_addr_r} #with this, we can run 'boot' in uboot to boot the kernel

FB: continue
FB: done